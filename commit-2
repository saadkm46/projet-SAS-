// Acheter et Afficher les tickets

function afficherTrajets() {
    console.log("\n=== TRAJETS DISPONIBLES ===");
    for (let trip of trips) {
        console.log(
            `#${trip.id} ${trip.departure} => ${trip.destination} | ` +
            `${trip.departureTime} - ${trip.arrivalTime} | ` +
            `${trip.price} DH | ${trip.availableSeats} places`
        );
    }
    menu();
}

function acheterTicket() {
    rl.question("Nom du passager : ", (name) => {

        rl.question("Identifiant du trajet : ", (answer) => {

            const trip = trips.find(t => t.id === Number(answer));

            if (!trip) {
                console.log("Trajet introuvable.");
                return menu();
            }

            if (trip.availableSeats === 0) {
                console.log("Train complet.");
                return menu();
            }

            const ticket = {
                id: tickets.length + 1,
                passengerName: name,
                tripId: trip.id,
                seatNumber: 51 - trip.availableSeats,
                price: trip.price
            };

            tickets.push(ticket);
            trip.availableSeats--;

            console.log("\nTicket acheté avec succès.");
            console.log(`Ticket #${ticket.id}`);
            console.log(`Passager : ${ticket.passengerName}`);
            console.log(`Place : ${ticket.seatNumber}`);
            console.log(`Prix : ${ticket.price} DH`);

            menu();
        });
    });
}



function afficherTickets() {
    console.log("\n=== TICKETS ===");

    if (tickets.length === 0) {
        console.log("Aucun ticket enregistré.");
        return menu();
    }

    for (let ticket of tickets) {
        const trip = trips.find(t => t.id === ticket.tripId);

        console.log(
            `Ticket #${ticket.id} | ` +
            `Passager : ${ticket.passengerName} | ` +
            `Trajet : ${trip.departure} → ${trip.destination} | ` +
            `Place : ${ticket.seatNumber} | ` +
            `Prix : ${ticket.price} DH`
        );
    }

    menu();
}
